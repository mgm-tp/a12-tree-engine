{
	"name": "@com.mgmtp.a12.treeengine/treeengine-model-migration",
	"version": "10.3.1",
	"type": "module",
	"description": "Tree Model Migration Tool",
	"author": "mgm technology partners",
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"scripts": {
		"clean": "rimraf lib/** target/**",
		"compile": "tsc -b",
		"start": "tsc -b --watch",
		"test": "pnpm \"/test:/\"",
		"test:steps": "vitest run",
		"test:consistency": "migration-tool-utils validate-consistency",
		"lint:eslint": "eslint --quiet",
		"update": "vitest run --update",
		"generate-step": "migration-tool-utils generate-step",
		"generate-schema": "migration-tool-utils compile",
		"migrate": "./bin/tree-model-migration .."
	},
	"dependencies": {
		"@com.mgmtp.a12.migrationtool/migrationtool-core": "catalog:a12Libs"
	},
	"devDependencies": {
		"@com.mgmtp.a12.base/base-model-api": "catalog:a12Libs",
		"@com.mgmtp.a12.migrationtool/migrationtool-utils": "catalog:a12Libs",
		"@com.mgmtp.a12.utils/utils-localization": "catalog:a12Libs",
		"@types/node": "catalog:devLibs",
		"@types/semver": "^7.7.1",
		"rimraf": "catalog:devLibs",
		"semver": "^7.7.3",
		"typescript": "catalog:libs",
		"vitest": "catalog:devLibs"
	},
	"bin": {
		"tree-model-migration": "./bin/tree-model-migration"
	},
	"files": [
		"bin",
		"lib",
		"src",
		"cyclonedx.json",
		"licenses",
		"LICENSE",
		"NOTICE",
		"THIRD_PARTY_NOTICES"
	],
	"main": "lib/api.js",
	"types": "lib/api.d.ts"
}
