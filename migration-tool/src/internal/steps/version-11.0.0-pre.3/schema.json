        },
        "configuration": {
          "$ref": "#/definitions/TreeModel.Configuration"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TreeModel.Column"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TreeModel.TreeNode"
          }
        },
        "styles": {
          "$ref": "#/definitions/TreeModel.Styles"
        }
      },
      "required": [
        "subHeaderBox",
