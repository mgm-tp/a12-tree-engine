    "TreeModel.Configuration": {
      "type": "object",
      "properties": {
        "rootRef": {
          "type": "string"
        },
        "hierarchicalColumnRef": {
          "type": "string"
        },
        "labelHidden": {
          "type": "boolean",
          "const": true
        },
        "wholeTreeExpansion": {
          "type": "boolean",
          "const": true
        },
        "enableColumnsResize": {
          "type": "boolean",
          "const": true
        },
        "dnd": {
