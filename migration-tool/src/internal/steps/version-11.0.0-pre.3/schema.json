        },
        "screenReaderColumnRef": {
          "type": "string",
          "description": "Optional reference to a Column ID whose cell content will be connected to row action buttons and checkboxes via aria-labelledby, improving screen reader accessibility. When not set, falls back to hierarchicalColumnRef."
        },
