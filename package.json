    "@com.mgmtp.a12.devtools/tsconfig": "catalog:devLibs",
    "@eslint/compat": "^2.1.0",
    "@jambit/eslint-plugin-typed-redux-saga": "^0.4.0",
    "@microsoft/api-extractor": "catalog:devLibs",
    "@types/react": "catalog:libs",
    "@types/react-dom": "catalog:libs",
    "eslint": "^10.4.1",
    "eslint-plugin-notice": "^1.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.8.3",
    "react": "catalog:libs",
    "react-dom": "catalog:libs",
    "redux-saga": "catalog:libs",
    "rimraf": "catalog:devLibs",
    "typed-redux-saga": "catalog:libs",
    "typescript": "catalog:libs"
  },
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d",
